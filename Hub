-- [[ CYBER ENGINE X.4 - SPEED, ANTI-DETECT & PLOT UTILITIES ]] --

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Player = Players.LocalPlayer

-- ULTRA BYPASS & ANTI-KICK SHIELD (MENUTUPI ERROR KICK SERVER)
pcall(function()
    local mt = getrawmetatable(game)
    if mt then
        setreadonly(mt, false)
        local oldNamecall = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method and (method:lower() == "kick" or method:lower() == "ban") and self == Player then
                return nil
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end
end)

local success, Rayfield = pcall(function()
    return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)

if not success or not Rayfield then
    Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/shlexware/Rayfield/main/source'))()
end

local Window = Rayfield:CreateWindow({
   Name = "⚡ Cyber Engine X.4 // Speed & Plot Hub",
   LoadingTitle = "Memuat Sistem Kecepatan...",
   LoadingSubtitle = "by Cyber Engine",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false, 
})

local SpeedTab = Window:CreateTab("🚀 Speed & Movement", 4483362458)
local PlotTab = Window:CreateTab("🏡 Plot & Safe Zone", 4483362458)
local MiscTab = Window:CreateTab("🛡️ Security & Anti-Detect", 4483362458)

local walkSpeedVal = 16
local jumpPowerVal = 50
local isSpeedEnabled = false
local isInfiniteJump = false
local customPlotPos = nil

-- TAB 1: SPEED & MOVEMENT
SpeedTab:CreateSection("⚡ Pengaturan Kecepatan Anti-Detect")

SpeedTab:CreateToggle({
   Name = "Aktifkan Custom WalkSpeed",
   CurrentValue = false,
   Callback = function(Value)
      isSpeedEnabled = Value
   end,
})

SpeedTab:CreateSlider({
   Name = "Kecepatan Jalan (WalkSpeed)",
   Range = {16, 250},
   Increment = 1,
   CurrentValue = 16,
   Flag = "SpeedSlider",
   Callback = function(Value)
      walkSpeedVal = Value
   end,
})

SpeedTab:CreateToggle({
   Name = "🚀 Infinite Jump (Loncat Terus Menerus)",
   CurrentValue = false,
   Callback = function(Value)
      isInfiniteJump = Value
   end,
})

-- TAB 2: PLOT & SAFE ZONE MANAGEMENT
PlotTab:CreateSection("🏡 Pengelolaan Plot & Teleport Base")

PlotTab:CreateButton({
   Name = "📍 Set Posisi Plot / Base Saya",
   Callback = function()
      pcall(function()
         local char = Player.Character
         if char and char:FindFirstChild("HumanoidRootPart") then
            customPlotPos = char.HumanoidRootPart.CFrame
            Rayfield:Notify({ Title = "Plot Disimpan!", Content = "Titik koordinat base kamu berhasil dikunci.", Duration = 3 })
         end
      end)
   end,
})

PlotTab:CreateButton({
   Name = "🏠 Teleport Instan Pulang ke Plot / Base",
   Callback = function()
      pcall(function()
         local char = Player.Character
         if char and char:FindFirstChild("HumanoidRootPart") and customPlotPos then
            char.HumanoidRootPart.CFrame = customPlotPos
            Rayfield:Notify({ Title = "Berhasil Pulang!", Content = "Karakter dipindahkan kembali ke plot.", Duration = 2 })
         else
            Rayfield:Notify({ Title = "Gagal!", Content = "Harap Set Posisi Plot terlebih dahulu!", Duration = 3 })
         end
      end)
   end,
})

-- TAB 3: SECURITY & ANTI-DETECT
MiscTab:CreateSection("🛡️ Perlindungan Akun & Server Bypass")

MiscTab:CreateToggle({
   Name = "🛡️ God Mode (Anti-Damage HP Penuh)",
   CurrentValue = false,
   Callback = function(Value)
      _G.GodMode = Value
   end,
})

MiscTab:CreateButton({
   Name = "🔄 Rejoin Server (Anti-Lag / Refresh)",
   Callback = function()
      game:GetService("TeleportService"):Teleport(game.PlaceId, Player)
   end,
})

-- LOOP UTAMA UNTUK SPEED HACK & INFINITE JUMP
RunService.Heartbeat:Connect(function()
    pcall(function()
        local char = Player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        
        if hum then
            if isSpeedEnabled then
                hum.WalkSpeed = walkSpeedVal
            else
                hum.WalkSpeed = 16
            end
            
            if _G.GodMode then
                hum.Health = hum.MaxHealth
            end
        end
    end)
end)

UserInputService.JumpRequest:Connect(function()
    pcall(function()
        if isInfiniteJump then
            local char = Player.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end
    end)
end)

Rayfield:Notify({
   Title = "Cyber Engine X.4 Aktif",
   Content = "Speed, Plot Teleport & Anti-Detect Siap Digunakan!",
   Duration = 5,
   Image = 4483362458,
})
