local function isInsideSafeZone(pos)
    if customBasePos then
        if (pos - customBasePos.Position).Magnitude < 80 then
            return true
        end
    end

    for _, obj in pairs(Workspace:GetDescendants()) do
        pcall(function()
            if obj and (obj:IsA("BasePart") or obj:IsA("Model")) then
                local name = obj.Name:lower()
                if name:find("safe") or (name:find("zone") and (name:find("base") or name:find("plot"))) then
                    local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                    if part and part:IsA("BasePart") then
                        if (pos - part.Position).Magnitude < 55 then
                            return true
                        end
                    end
                end
            end
        end)
    end
    return false
end

local function matchesSelectedZone(obj)
    local anyZoneSelected = false
    for _, active in pairs(selectedZones) do
        if active then anyZoneSelected = true break end
    end
    if not anyZoneSelected then return false end

    local fullName = ""
    local curr = obj
    while curr and curr ~= Workspace do
        fullName = fullName .. " " .. curr.Name:lower()
        curr = curr.Parent
    end

    if selectedZones.Forest and (fullName:find("forest") or fullName:find(" kayu ")) then return true end
    if selectedZones.Dune and (fullName:find("dune") or fullName:find("desert") or fullName:find("pasir")) then return true end
    if selectedZones.Swamp and (fullName:find("swamp") or fullName:find("rawa")) then return true end
    if selectedZones.Mushroom and (fullName:find("mushroom") or fullName:find("jamur")) then return true end
    if selectedZones.Ocean and (fullName:find("ocean") or fullName:find("water") or fullName:find("sea") or fullName:find("laut")) then return true end
    if selectedZones.Lava and (fullName:find("lava") or fullName:find("volcano") or fullName:find("api")) then return true end
    if selectedZones.Snow and (fullName:find("snow") or fullName:find("ice") or fullName:find("winter") or fullName:find("salju")) then return true end
    if selectedZones.DragonRuins and (fullName:find("dragon") or fullName:find("ruins") or fullName:find("naga")) then return true end
    if selectedZones.Jurassic and (fullName:find("jurassic") or fullName:find("dino")) then return true end
    if selectedZones.Mutant and (fullName:find("mutant") or fullName:find("toxic") or fullName:find("radioactive")) then return true end
    if selectedZones.Galaxy and (fullName:find("galaxy") or fullName:find("space") or fullName:find("cosmic") or fullName:find(" bintang ")) then return true end

    return false
end

task.spawn(function()
    while task.wait(1.2) do
        pcall(function()
            if not isAutoEgg then return end
            local char = Player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local baseCFrame = customBasePos or hrp.CFrame

            for _, obj in pairs(Workspace:GetDescendants()) do
                if not isAutoEgg then break end
                pcall(function()
                    if obj and (obj:IsA("Model") or obj:IsA("BasePart")) then
                        local name = obj.Name:lower()
                        
                        if (name:find("egg") or name:find("telur") or name:find("nest")) 
                           and not name:find("player") 
                           and not name:find("character") 
                           and not name:find("ui") then
                            
                            local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                            if part and part:IsA("BasePart") and part.Position.Y > -30 then
                                
                                local inSafe = isInsideSafeZone(part.Position)
                                local inCorrectZone = matchesSelectedZone(obj)

                                if not inSafe and inCorrectZone and (not farmedCache[part] or (tick() - farmedCache[part] > 8)) then
                                    farmedCache[part] = tick()

                                    hrp.CFrame = part.CFrame * CFrame.new(0, 3, 0)
                                    task.wait(0.35)

                                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) or part:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt and fireproximityprompt then
                                        fireproximityprompt(prompt)
                                    end

                                    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                                        if remote:IsA("RemoteEvent") then
                                            local rName = remote.Name:lower()
                                            if rName:find("egg") or rName:find("pickup") or rName:find("collect") or rName:find("claim") then
                                                pcall(function()
                                                    remote:FireServer(obj)
                                                    remote:FireServer(part)
                                                end)
                                            end
                                        end
                                    end

                                    if firetouchinterest then
                                        firetouchinterest(hrp, part, 0)
                                        task.wait(0.08)
                                        firetouchinterest(hrp, part, 1)
                                    end

                                    task.wait(0.6)
                                    hrp.CFrame = baseCFrame
                                    task.wait(0.8)
                                end
                            end
                        end
                    end
                end)
            end
        end)
    end
end)

