local function isInsideSafeZone(pos)
    if customBasePos then
        if (pos - customBasePos.Position).Magnitude < 70 then
            return true
        end
    end
    return false
end

local function matchesSelectedZone(obj)
    local anyZoneSelected = false
    for _, active in pairs(selectedZones) do
        if active then anyZoneSelected = true break end
    end
    if not anyZoneSelected then return false end

    local fullName = ""
    local curr = obj
    while curr and curr ~= Workspace do
        fullName = fullName .. " " .. curr.Name:lower()
        curr = curr.Parent
    end

    if selectedZones.Forest and fullName:find("forest") then return true end
    if selectedZones.Dune and (fullName:find("dune") or fullName:find("desert")) then return true end
    if selectedZones.Swamp and fullName:find("swamp") then return true end
    if selectedZones.Mushroom and fullName:find("mushroom") then return true end
    if selectedZones.Ocean and (fullName:find("ocean") or fullName:find("water") or fullName:find("sea")) then return true end
    if selectedZones.Lava and (fullName:find("lava") or fullName:find("volcano")) then return true end
    if selectedZones.Snow and (fullName:find("snow") or fullName:find("ice")) then return true end
    if selectedZones.DragonRuins and (fullName:find("dragon") or fullName:find("ruins")) then return true end
    if selectedZones.Jurassic and fullName:find("jurassic") then return true end
    if selectedZones.Mutant and (fullName:find("mutant") or fullName:find("toxic")) then return true end
    if selectedZones.Galaxy and (fullName:find("galaxy") or fullName:find("space")) then return true end

    return false
end

-- LOGIKA FARMING RINGAN & ANTI-LAG
task.spawn(function()
    while task.wait(1.0) do
        pcall(function()
            if not isAutoEgg then return end
            local char = Player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local baseCFrame = customBasePos or hrp.CFrame

            -- Ambil hanya objek yang relevan di workspace tanpa meload semuanya secara berlebihan
            for _, obj in pairs(Workspace:GetChildren()) do
                if not isAutoEgg then break end
                pcall(function()
                    -- Cek folder zona atau langsung ke objek telur
                    local targets = obj:IsA("Model") or obj:IsA("Folder") and obj:GetDescendants() or {obj}
                    for _, targetObj in pairs(targets) do
                        if not isAutoEgg then break end
                        if targetObj and (targetObj:IsA("Model") or targetObj:IsA("BasePart")) then
                            local name = targetObj.Name:lower()
                            if (name:find("egg") or name:find("telur") or name:find("nest")) and not name:find("player") then
                                local part = targetObj:IsA("Model") and (targetObj.PrimaryPart or targetObj:FindFirstChildWhichIsA("BasePart")) or targetObj
                                if part and part:IsA("BasePart") and part.Position.Y > -30 then
                                    
                                    if not isInsideSafeZone(part.Position) and matchesSelectedZone(targetObj) then
                                        if not farmedCache[part] or (tick() - farmedCache[part] > 6) then
                                            farmedCache[part] = tick()

                                            -- 1. TELEPORT KE TELUR
                                            hrp.CFrame = part.CFrame * CFrame.new(0, 3, 0)
                                            task.wait(0.2)

                                            -- 2. PROXIMITY PROMPT & REMOTE EVENT
                                            local prompt = targetObj:FindFirstChildWhichIsA("ProximityPrompt", true) or part:FindFirstChildWhichIsA("ProximityPrompt", true)
                                            if prompt and fireproximityprompt then
                                                fireproximityprompt(prompt)
                                            end

                                            for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                                                if remote:IsA("RemoteEvent") then
                                                    local rName = remote.Name:lower()
                                                    if rName:find("egg") or rName:find("pickup") or rName:find("collect") then
                                                        pcall(function() remote:FireServer(targetObj) remote:FireServer(part) end)
                                                    end
                                                end
                                            end

                                            if firetouchinterest then
                                                firetouchinterest(hrp, part, 0)
                                                task.wait(0.05)
                                                firetouchinterest(hrp, part, 1)
                                            end

                                            -- 3. JEDA SEBENTAR SUPAYA MASUK TAS
                                            task.wait(0.4)

                                            -- 4. PULANG KE BASE
                                            hrp.CFrame = baseCFrame
                                            task.wait(0.5)
                                            break
                                        end
                                    end
                                end
                            end
                        end
                    end
                end)
            end
        end)
    end
end)

